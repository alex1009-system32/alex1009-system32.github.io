# Kopie als .env oder .env.local anlegen und anpassen.
#
# ACHTUNG: Alles mit VITE_-Praefix landet im Client-Bundle und ist oeffentlich
# lesbar. Hier gehoeren nur unkritische Werte hinein - niemals API-Keys,
# Tokens oder Passwoerter.

# GitHub-Nutzername, dessen Profil und Repositories angezeigt werden.
# Optional: ohne Angabe greift der Fallback in src/lib/config.ts.
VITE_GITHUB_USERNAME=alex1009-system32
